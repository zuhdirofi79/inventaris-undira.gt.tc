APP_NAME="Inventaris UNDIRA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Production checklist:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.example
# FORCE_HTTPS=true
# SESSION_SECURE_COOKIE=true

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# --- Hostinger Business (MySQL/MariaDB) ---
# 1) Buat database + user di hPanel
# 2) Jalankan schema: php artisan migrate --force
# 3) Migrasi data dari SQLite lokal:
#    php artisan inventory:migrate-sqlite-to-mysql \
#      --sqlite-path=database/database.sqlite \
#      --host=localhost --database=YOUR_DB --username=YOUR_USER --password=YOUR_PASS --force
# 4) Switch koneksi aplikasi:
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=YOUR_DB
# DB_USERNAME=YOUR_USER
# DB_PASSWORD=YOUR_PASS
#
# Opsional (jika DB_CONNECTION masih sqlite saat menjalankan command):
# MYSQL_MIGRATE_HOST=localhost
# MYSQL_MIGRATE_PORT=3306
# MYSQL_MIGRATE_DATABASE=YOUR_DB
# MYSQL_MIGRATE_USERNAME=YOUR_USER
# MYSQL_MIGRATE_PASSWORD=YOUR_PASS

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Development: MAIL_MAILER=log (tidak mengirim email sungguhan)
# Production Hostinger SMTP: MAIL_MAILER=smtp (isi host/user/password di server, jangan commit)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
